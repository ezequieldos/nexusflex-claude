{
  "name": "nexusflex",
  "description": "Nexus Flex en Claude: el MCP (altas, consultas, control por foto; nunca mueve dinero) y las skills (control por foto) en un solo instalable.",
  "version": "3.72.0",
  "author": { "name": "Nexus Flex", "url": "https://nexusflex.com.ar" },
  "homepage": "https://nexusflex.com.ar/mcp",
  "license": "MIT",
  "mcpServers": {
    "nexusflex": {
      "command": "npx",
      "args": ["-y", "nexusflex-mcp@latest"],
      "env": {
        "NEXUSFLEX_MCP_ALLOW_WRITE": "true",
        "NEXUSFLEX_MCP_ALLOW_PRECIOS": "false"
      }
    }
  }
}
